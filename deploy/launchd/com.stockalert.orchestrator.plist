<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stockalert.orchestrator</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/apps/stock-alert-platform/stock-alert-saas/.venv-backend/bin/python</string>
        <string>-u</string>
        <string>-m</string>
        <string>app.backend.orchestrator</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__HOME__/apps/stock-alert-platform/stock-alert-saas</string>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/com.stockalert.orchestrator.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/com.stockalert.orchestrator-error.log</string>
</dict>
</plist>
